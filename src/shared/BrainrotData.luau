-- Weighted pick helpers (used by the server conveyor).
local function rollWeighted(list, weightKey)
	local total = 0
	for _, item in ipairs(list) do total += item[weightKey] end
	local roll = math.random() * total
	for _, item in ipairs(list) do
		roll -= item[weightKey]
		if roll <= 0 then return item end
	end
	return list[#list]
end

function BrainrotData.rollCharacter()
	local rarity = rollWeighted(BrainrotData.RARITIES_ARRAY, "weight")
	local pool = {}
	for _, ch in ipairs(BrainrotData.CHARACTERS) do
		if ch.rarity == rarity.name then table.insert(pool, ch) end
	end
	return pool[math.random(1, #pool)]
end

BrainrotData.RARITIES_ARRAY = {}
for _, r in ipairs({
	{ name = "Common", weight = 38 },
	{ name = "Rare", weight = 26 },
	{ name = "Epic", weight = 15 },
	{ name = "Legendary", weight = 9 },
	{ name = "Mythic", weight = 6 },
	{ name = "Secret", weight = 4 },
	{ name = "Divine", weight = 2 },
}) do table.insert(BrainrotData.RARITIES_ARRAY, r) end

function BrainrotData.rollMutation()
	return rollWeighted(BrainrotData.MUTATIONS, "weight")
end

return BrainrotData
